# App Configuration
NEXT_PUBLIC_APP_NAME=JJIKMEOK
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
API_SECRET_KEY=your_secret_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/jjikmeok
REDIS_URL=redis://localhost:6379

# OAuth - TikTok
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback

# OAuth - YouTube (Google)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# OAuth - Instagram (Meta)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# Mapbox (for geo-based creator discovery)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token

# OpenAI (for AI profile inference)
OPENAI_API_KEY=your_openai_api_key

# PaddleOCR (for screenshot verification)
PADDLE_OCR_API_URL=http://localhost:8866

# Payment Gateway (Toss Payments)
TOSS_CLIENT_KEY=your_toss_client_key
TOSS_SECRET_KEY=your_toss_secret_key

# AWS S3 (for video/image storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=jjikmeok-media

# Monitoring & Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
SENTRY_DSN=your_sentry_dsn

# Feature Flags
NEXT_PUBLIC_ENABLE_SHOT_COACH=true
NEXT_PUBLIC_ENABLE_GUEST_MODE=true
NEXT_PUBLIC_MIN_FOLLOWER_COUNT=100
